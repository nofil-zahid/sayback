{
  "name": "sayback",
  "version": "1.0.1",
  "description": "A CLI tool that animates terminal text with a retro character-cycling typewriter effect.",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nofil-zahid/sayback.git"
  },
  "bin": {
    "sayback": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --watch ./src/index.ts",
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "prepare": "husky",
    "postinstall": "node dist/scripts/postinstall.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "say",
    "speech",
    "synthesis",
    "text-to-speech",
    "tts",
    "utilities",
    "cli",
    "command-line-tool"
  ],
  "author": "Nofil Zahid",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
